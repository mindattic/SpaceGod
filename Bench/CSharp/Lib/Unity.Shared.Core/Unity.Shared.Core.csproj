<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity.Shared's engine-free Unity.Shared.Core (player profiles, settings.json), compiled from the package's own
       source in place, as Unity.SpaceGod's Tests/Unity.Shared.Core does (netstandard2.1, C# 9). Nothing is copied.
       Set UnitySharedDir when the Unity.Shared checkout is not next to this repo. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Unity.Shared.Core</AssemblyName>
    <RootNamespace>Unity.Shared.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <UnitySharedDir Condition="'$(UnitySharedDir)' == ''">$(MSBuildThisFileDirectory)../../../../../Unity.Shared/</UnitySharedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnitySharedDir)unity/com.mindattic.unity.shared/Runtime/Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>
  <Target Name="RequireUnityShared" BeforeTargets="CoreCompile" Condition="!Exists('$(UnitySharedDir)unity/com.mindattic.unity.shared/package.json')">
    <Error Text="The Unity.Shared repo was not found at $(UnitySharedDir). Clone it next to Unreal.SpaceGod, or set UnitySharedDir to its folder." />
  </Target>
</Project>
