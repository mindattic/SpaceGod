<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Bench's own build of Unity.SpaceGod's engine-free Core: Assets/UnitySpace/Core/**/*.cs compiled UNCHANGED and
       IN PLACE from the Unity.SpaceGod checkout next to this repo (netstandard2.1, C# 9, assembly Unity.SpaceGod.Core),
       exactly as its Tests/UnitySpace.Core csproj does. Kept separate from CSharp/Core so the Bench never writes build
       output into the game track. Set UnitySpaceGodDir when the checkout is elsewhere. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Unity.SpaceGod.Core</AssemblyName>
    <RootNamespace>Unity.SpaceGod.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS0067;CS1998</NoWarn>
    <UnitySpaceGodDir Condition="'$(UnitySpaceGodDir)' == ''">$(MSBuildThisFileDirectory)../../../../../Unity.SpaceGod/</UnitySpaceGodDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnitySpaceGodDir)Assets/UnitySpace/Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Unity.Shared.Core/Unity.Shared.Core.csproj" />
  </ItemGroup>
  <Target Name="RequireUnitySpaceGod" BeforeTargets="CoreCompile" Condition="!Exists('$(UnitySpaceGodDir)Assets/UnitySpace/Core/World.cs')">
    <Error Text="The Unity.SpaceGod repo was not found at $(UnitySpaceGodDir). Clone it next to Unreal.SpaceGod, or set UnitySpaceGodDir to its folder." />
  </Target>
</Project>
