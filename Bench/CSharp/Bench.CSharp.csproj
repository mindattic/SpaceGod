<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bench.CSharp: the headless runner over Unity.SpaceGod's own C# Core (see ../README.md). The Core is linked from
       the Unity.SpaceGod checkout in place through Lib/; nothing of it is copied into this repo. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0 is what the C# game track runs (UnrealSharp on UE 5.8); net8.0 kept for comparison (tools/bench.ps1 -DotNet). -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Bench.CSharp</AssemblyName>
    <RootNamespace>Bench.CSharp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Lib/SpaceGod.Core/SpaceGod.Core.csproj" />
    <ProjectReference Include="Lib/Unity.Shared.Core/Unity.Shared.Core.csproj" />
  </ItemGroup>
</Project>
