<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reference generator for Tests/CsParity: prints .NET's own results (net10.0, as Unity.SpaceGod's
       Tests/UnitySpace.Core runs the C# Core). Not part of any build; see Program.cs for how to regenerate. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\..\..\Intermediate\CsParityDotNet\bin\</OutputPath>
  </PropertyGroup>
</Project>
