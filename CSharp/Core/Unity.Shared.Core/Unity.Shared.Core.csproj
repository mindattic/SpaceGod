<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity.Shared's engine-free Unity.Shared.Core assembly (player profiles, settings.json), compiled from the
       package's own source in place, exactly as Unity.SpaceGod's Tests/Unity.Shared.Core does (.NET Standard 2.1,
       C# 9). Nothing is copied into this repo. The Unity.Shared repo is expected next to this one
       (D:\Projects\MindAttic\Unity.Shared); set UnitySharedDir (property or environment variable) otherwise. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Unity.Shared.Core</AssemblyName>
    <RootNamespace>Unity.Shared.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <UnitySharedDir Condition="'$(UnitySharedDir)' == ''">$(MSBuildThisFileDirectory)../../../../Unity.Shared/</UnitySharedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnitySharedDir)unity/com.mindattic.unity.shared/Runtime/Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>
  <Target Name="RequireUnityShared" BeforeTargets="CoreCompile" Condition="!Exists('$(UnitySharedDir)unity/com.mindattic.unity.shared/package.json')">
    <Error Text="The Unity.Shared repo was not found at $(UnitySharedDir). Clone it next to Unreal.SpaceGod, or set UnitySharedDir to its folder." />
  </Target>
</Project>
