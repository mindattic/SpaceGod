// Unity.SpaceGod/Ring (Ring.shader + Passes/Ring.hlsl): Saturn's rings. Radial opacity profile of the C ring,
// B ring, Cassini Division and A ring (with the Encke Gap), lit from either face, and shadowed by the planet with an
// analytic ray-sphere test toward the Sun. Returns colour (rgb) and opacity (a).
#ifndef SPACEGOD_RING_USH
#define SPACEGOD_RING_USH
#include "/Plugin/SpaceGodRender/SpaceGodCommon.ush"

float SG_RingOpacity(float r)
{
    if (r < 92000.0) return 0.14 + 0.06 * sin(r * 0.0021);
    if (r < 117580.0) return 0.78 + 0.12 * sin(r * 0.0011) + 0.07 * sin(r * 0.0053);
    if (r < 122170.0) return 0.05;
    if (r > 133423.0 && r < 133745.0) return 0.04;
    return 0.55 + 0.1 * sin(r * 0.0031);
}

// normalWS: the ring plane's normal (Unity's object +Y == Unreal's local +Z) taken to world.
// planetRel: camera-relative planet centre; planetRadius in world units.
float4 SG_Ring(float2 uvUE, float3 positionCR, float3 normalWS,
    float3 sunRel, float3 sunColor, float3 sun2Rel, float3 sun2Color,
    float3 _Color, float _InnerKm, float _OuterKm, float3 planetRel, float planetRadius)
{
    // uv.x runs 0 at the inner edge to 1 at the outer edge (V is not used, so no flip).
    float r = lerp(_InnerKm, _OuterKm, uvUE.x);
    float alpha = SG_RingOpacity(r) * smoothstep(0.0, 0.01, uvUE.x) * smoothstep(1.0, 0.99, uvUE.x);

    float3 l = normalize(sunRel - positionCR);
    float3 n = normalize(normalWS);
    float3 light = 0.3 * sunColor + 0.7 * abs(dot(n, l)) * sunColor
        + 0.7 * abs(dot(n, normalize(sun2Rel - positionCR))) * sun2Color;

    float3 oc = positionCR - planetRel;
    float b = dot(oc, l);
    float c = dot(oc, oc) - planetRadius * planetRadius;
    float disc = b * b - c;
    if (disc > 0.0 && (-b + sqrt(disc)) > 0.0 && c > 0.0 && b < 0.0) light *= 0.06;

    float3 col = _Color * (0.85 + 0.25 * sin(r * 0.00042)) * light;
    return float4(col, alpha);
}

#endif
