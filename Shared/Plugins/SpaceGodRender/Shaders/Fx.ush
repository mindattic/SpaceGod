// Unity.SpaceGod/Fx (Fx.shader + Passes/Fx.hlsl): additive battle effects batched into one dynamic mesh of
// camera-facing quads: laser beams and tracers (soft-edged ribbons), explosions and missile glows (radial), shield
// flashes (rings) and shield bubble segments (a hex lattice with a ripple from the impact).
// Unity's TEXCOORD0.xy is the quad UV (Unreal: TexCoord0, V flipped), TEXCOORD0.z picks the shape (Unreal:
// TexCoord1.x), the vertex colour carries tint and fade.
#ifndef SPACEGOD_FX_USH
#define SPACEGOD_FX_USH
#include "/Plugin/SpaceGodRender/SpaceGodCommon.ush"

float3 SG_Fx(float2 uvUE, float shapeSelect, float4 vertexColor)
{
    float3 uv = float3(SG_UnityUv(uvUE), shapeSelect);
    float2 p = uv.xy * 2.0 - 1.0;
    float shape;
    if (uv.z < 0.5)
    {
        // Radial: a hot core with a soft halo.
        float d = saturate(1.0 - length(p));
        shape = d * d + pow(d, 8.0) * 1.5;
    }
    else if (uv.z < 1.5)
    {
        // Beam: bright core across the ribbon, tapered at both ends.
        float across = saturate(1.0 - abs(p.y));
        float along = saturate(min(uv.x, 1.0 - uv.x) * 12.0);
        shape = (across * across + pow(across, 10.0) * 2.0) * along;
    }
    else if (uv.z < 2.5)
    {
        // Ring: a thin bright shell (shield flashes too small on screen for a bubble).
        float d = length(p);
        shape = saturate(1.0 - abs(d - 0.85) * 8.0) * step(d, 1.0) + saturate(1.0 - d) * 0.15;
    }
    else
    {
        // Shield bubble segment (U.SPC-T40): a hex lattice on a patch of the shield shell, centred on
        // the impact, with a ripple running out from it. uv.z - 3 is the flash's age, 0 to 1.
        float phase = saturate(uv.z - 3.0);
        float r = length(p);
        float mask = saturate((1.0 - r) * 3.0);
        float2 q = p * 5.0;
        const float2 s = float2(1.0, 1.7320508);
        float2 a = q - s * floor(q / s) - s * 0.5;
        float2 b = (q - s * 0.5) - s * floor((q - s * 0.5) / s) - s * 0.5;
        float2 g = dot(a, a) < dot(b, b) ? a : b;
        float2 ag = abs(g);
        float edge = 0.5 - max(dot(ag, normalize(s)), ag.x);
        float lines = saturate(1.0 - edge * 10.0);
        float front = phase * 1.1;
        float ripple = saturate(1.0 - abs(r - front) * 6.0) * (1.0 - phase * 0.5);
        float core = (1.0 - phase) * pow(saturate(1.0 - r * 2.5), 2.0);
        float fall = 1.0 - r * 0.6;
        shape = mask * (lines * (0.35 + ripple * 1.4) * fall + ripple * 0.35 + core * 1.5 + 0.08);
    }
    // Additive light must tone-map, not clip (US-T216): a hot core times a bright tint reads 2-3x over white, and a
    // saturating channel loses its hue and goes to a solid white disc. Compress the brightest channel with a soft
    // knee (unchanged below it, an asymptote of 1 above) and scale the other channels with it, so hot stays coloured.
    float3 c = vertexColor.rgb * shape * vertexColor.a;
    const float knee = 0.55;
    float m = max(c.r, max(c.g, c.b));
    if (m > knee)
        c *= (knee + (1.0 - knee) * (1.0 - exp(-(m - knee) / (1.0 - knee)))) / m;
    return c;
}

#endif
