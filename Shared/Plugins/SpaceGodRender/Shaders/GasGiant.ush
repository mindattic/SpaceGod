// Unity.SpaceGod/GasGiant (GasGiant.shader + Passes/GasGiant.hlsl): giant planet cloud decks that move with the
// planet's real zonal winds.
//
// Each latitude of the colour map drifts in longitude at the measured wind speed relative to the planet's rotation
// frame (_Drift, deg/day, sampled every 5 degrees from GasGiantWeather). Winds shear neighbouring latitudes apart, so
// the drift is applied as a flow map: two copies of the map are advected over a short loop (_Flow.z days) half a loop
// apart and cross-faded, so detail moves at the right speed and direction but never smears out over long runs.
// Small-scale turbulence is a noise displacement advected the same way.
//
// Jupiter's Great Red Spot: the whole map is turned so the spot on the 2015 Hubble map lands at its current System III
// longitude (_Grs.z), and inside the oval the map turns counter-clockwise (an anticyclone in the southern hemisphere)
// along elliptical streamlines, fastest in the collar, once per _GrsShape.z days.
//
// Unreal has no array material parameters: Unity's float _Drift[37] arrives as ten vector parameters _Drift_0 ..
// _Drift_9, _Drift[k] in component k % 4 of _Drift_(k / 4) (the last three components unused).
#ifndef SPACEGOD_GASGIANT_USH
#define SPACEGOD_GASGIANT_USH
#include "/Plugin/SpaceGodRender/SpaceGodCommon.ush"

struct FSGGasGiantParams
{
    float Drift[40];
    float4 Flow;      // phase A (0..1), phase B, loop length (days), amount (0..1)
    float4 Grs;       // centre east longitude (deg), latitude (deg), band shift (deg), enabled
    float4 GrsShape;  // half-width (deg lon), half-height (deg lat), collar rotation period (days)
    float Turbulence;
    float PoleMargin;
};

float SG_GasGiantDriftAt(FSGGasGiantParams P, float lat)
{
    float f = clamp((lat + 90.0) / 5.0, 0.0, 35.999);
    int k = (int)f;
    return lerp(P.Drift[k], P.Drift[k + 1], f - k);
}

float SG_WrapDeg(float d) { return d - 360.0 * floor(d / 360.0 + 0.5); }

// Map coordinates (lon, lat in degrees) to sample for display point (lon, lat) after tau days of flow.
float2 SG_GasGiantAdvect(FSGGasGiantParams P, float lon, float lat, float tau, float amount)
{
    // The whole map is turned in longitude so the mapped spot sits at its current System III
    // longitude (sliding only its band would shear the band edges into streaks).
    float baseLon = lon + P.Grs.w * P.Grs.z;

    // Zonal wind: the cloud now at lon came from upstream.
    float2 zonal = float2(baseLon - SG_GasGiantDriftAt(P, lat) * tau * amount, lat);

    // Turbulent eddies, advected with the same clock.
    // Sampled on the sphere (no seam at the date line), squashed north-south like the bands.
    float lonR = radians(lon), latR = radians(lat);
    float3 q = float3(cos(latR) * cos(lonR), sin(latR) * 1.8, cos(latR) * sin(lonR)) * 14.0 + tau * 1.7;
    float2 eddy = float2(SolarValueNoise(q) - 0.5, SolarValueNoise(q + 19.7) - 0.5);
    zonal += eddy * P.Turbulence * float2(1.0, 0.5) * amount;

    if (P.Grs.w < 0.5) return zonal;

    // Inside the oval: rotate counter-clockwise along elliptical streamlines.
    float2 e = float2(SG_WrapDeg(lon - P.Grs.x) / P.GrsShape.x, (lat - P.Grs.y) / P.GrsShape.y);
    float r = length(e);
    if (r > 1.35) return zonal;
    // Angular speed profile: quiet core, fastest in the collar near r = 0.8, fading outside.
    float speed = lerp(0.25, 1.0, smoothstep(0.1, 0.75, r)) * (1.0 - smoothstep(0.95, 1.3, r));
    float angle = -6.2831853 * tau / P.GrsShape.z * speed * amount; // sample clockwise = features turn CCW
    float c = cos(angle), s = sin(angle);
    float2 er = float2(e.x * c - e.y * s, e.x * s + e.y * c);
    float2 vortex = float2(P.Grs.x + er.x * P.GrsShape.x + P.Grs.z, P.Grs.y + er.y * P.GrsShape.y);
    float m = 1.0 - smoothstep(1.0, 1.35, r);
    return lerp(zonal, vortex, m);
}

// Explicit gradients from the mesh UVs: the advected coordinates jump where they wrap in
// longitude, which would otherwise pick the smallest mip along a seam.
float3 SG_GasGiantSampleMap(FSGGasGiantParams P, Texture2D mainTex, SamplerState mainTexSampler, float2 lonLat, float2 dx, float2 dy)
{
    float2 uv = float2(lonLat.x / 360.0 + 0.5, lonLat.y / 180.0 + 0.5);
    uv.y = clamp(uv.y, P.PoleMargin, 1.0 - P.PoleMargin);
    return Texture2DSampleGrad(mainTex, mainTexSampler, SG_UnityUv(uv), dx, dy).rgb;
}

float3 SG_GasGiant(float2 uvUE, float3 normalWS, float3 positionCR,
    float3 sunRel, float3 sunColor, float3 sun2Rel, float3 sun2Color,
    Texture2D mainTex, SamplerState mainTexSampler,
    float4 d0, float4 d1, float4 d2, float4 d3, float4 d4, float4 d5, float4 d6, float4 d7, float4 d8, float4 d9,
    float4 _Flow, float4 _Grs, float4 _GrsShape,
    float _PoleMargin, float3 _AtmoColor, float _AtmoStrength, float _Ambient, float _Highlight, float _Turbulence)
{
    FSGGasGiantParams P;
    float4 d[10] = { d0, d1, d2, d3, d4, d5, d6, d7, d8, d9 };
    [unroll] for (int k = 0; k < 10; k++)
    {
        P.Drift[k * 4 + 0] = d[k].x;
        P.Drift[k * 4 + 1] = d[k].y;
        P.Drift[k * 4 + 2] = d[k].z;
        P.Drift[k * 4 + 3] = d[k].w;
    }
    P.Flow = _Flow;
    P.Grs = _Grs;
    P.GrsShape = _GrsShape;
    P.Turbulence = _Turbulence;
    P.PoleMargin = _PoleMargin;

    float3 n = normalize(normalWS);
    float3 l = normalize(sunRel - positionCR);
    float3 viewDir = normalize(-positionCR);

    float2 uvUnity = SG_UnityUv(uvUE);
    float lon = (uvUnity.x - 0.5) * 360.0;
    float lat = (uvUnity.y - 0.5) * 180.0;
    float2 dx = ddx(uvUE), dy = ddy(uvUE);

    float phaseA = _Flow.x, phaseB = _Flow.y, loopDays = _Flow.z, amount = _Flow.w;
    float3 a = SG_GasGiantSampleMap(P, mainTex, mainTexSampler, SG_GasGiantAdvect(P, lon, lat, phaseA * loopDays, amount), dx, dy);
    float3 b = SG_GasGiantSampleMap(P, mainTex, mainTexSampler, SG_GasGiantAdvect(P, lon, lat, phaseB * loopDays, amount), dx, dy);
    float wa = 1.0 - abs(2.0 * phaseA - 1.0);
    float3 albedo = lerp(b, a, wa);

    float ndl = dot(n, l);
    float lit = saturate(ndl * 1.05 + 0.03) * smoothstep(-0.12, 0.1, ndl);
    float3 l2 = normalize(sun2Rel - positionCR);
    float ndl2 = dot(n, l2);
    float lit2 = saturate(ndl2 * 1.05) * smoothstep(-0.12, 0.1, ndl2);
    // Mild limb darkening of a deep atmosphere.
    float mu = saturate(dot(n, viewDir));
    float limb = lerp(0.72, 1.0, sqrt(mu));
    float3 col = albedo * ((lit * sunColor + lit2 * sun2Color) * limb + _Ambient);

    float rim = pow(1.0 - mu, 3.0);
    float3 daySide = smoothstep(-0.35, 0.45, ndl) * sunColor + smoothstep(-0.35, 0.45, ndl2) * sun2Color;
    col += _AtmoColor * rim * _AtmoStrength * daySide;
    col += float3(0.35, 0.7, 1.0) * rim * _Highlight * 0.35;
    return col;
}

#endif
