// Unity.SpaceGod/Ship (Ship.shader + Passes/Ship.hlsl): ship hulls. Sun-lit Lambert plus a little specular and a cool
// fill so silhouettes read on the night side. Vertex colours carry the paint scheme; vertex alpha below 0.5 marks
// emissive panels (engine bells, hangar mouths), scaled by _EngineGlow. Every hull is plated with a seamless sci-fi
// panel texture (ambientCG MetalPlates015A, CC0), projected triplanar in object space since the procedural meshes have
// no UVs: R is the greyscale albedo detail, G/B the normal map's Y/X.
#ifndef SPACEGOD_SHIP_USH
#define SPACEGOD_SHIP_USH
#include "/Plugin/SpaceGodRender/SpaceGodCommon.ush"

float3 SG_Ship(float3 normalWS, float3 positionCR, float3 positionOSUE, float4 vertexColor,
    float3x3 localToWorld, float3 invScale,
    float3 sunRel, float3 sunColor, float3 sun2Rel, float3 sun2Color,
    Texture2D plating, SamplerState platingSampler,
    float3 _Color, float3 _Tint, float _UseVertexColor, float _EngineGlow, float3 _EngineColor, float _Highlight,
    float _PlatingScale, float _PlatingStrength)
{
    float4 color = lerp(float4(1, 1, 1, 1), vertexColor, _UseVertexColor);
    float3 n = normalize(normalWS);
    float3 l = normalize(sunRel - positionCR);
    float3 v = normalize(-positionCR);
    float3 albedo = _Color * _Tint * color.rgb;

    // Triplanar plating: blend the three axis projections by the face normal (in Unity's object axes).
    if (_PlatingStrength > 0.0 && color.a >= 0.5)
    {
        float3 nO = SG_UnityFromUnreal(SG_WorldNormalToLocal(n, localToWorld));
        float3 w = pow(abs(nO), 4.0);
        w /= (w.x + w.y + w.z);
        float3 p = SG_UnityFromUnreal(positionOSUE) * _PlatingScale;
        float3 sx = Texture2DSample(plating, platingSampler, SG_UnityUv(p.zy)).rgb;
        float3 sy = Texture2DSample(plating, platingSampler, SG_UnityUv(p.xz)).rgb;
        float3 sz = Texture2DSample(plating, platingSampler, SG_UnityUv(p.xy)).rgb;
        float detail = sx.r * w.x + sy.r * w.y + sz.r * w.z;
        albedo *= lerp(1.0, detail * 2.0, _PlatingStrength);
        float2 tx = sx.bg * 2.0 - 1.0, ty = sy.bg * 2.0 - 1.0, tz = sz.bg * 2.0 - 1.0;
        float3 bumped = nO + (float3(0, tx.y, tx.x) * w.x + float3(ty.x, 0, ty.y) * w.y + float3(tz.x, tz.y, 0) * w.z) * _PlatingStrength;
        n = SG_LocalNormalToWorld(SG_UnrealFromUnity(normalize(bumped)), localToWorld, invScale);
    }

    float ndl = saturate(dot(n, l));
    float fill = saturate(dot(n, -l)) * 0.07 + 0.05;
    float spec = pow(saturate(dot(n, normalize(l + v))), 24.0) * 0.35 * step(0.0, dot(n, l));
    float rim = pow(1.0 - saturate(dot(n, v)), 4.0);
    float3 l2 = normalize(sun2Rel - positionCR);
    float ndl2 = saturate(dot(n, l2));

    float3 col = albedo * (ndl * sunColor + ndl2 * sun2Color + fill) + spec * sunColor;
    col += float3(0.35, 0.7, 1.0) * rim * _Highlight * 0.6;

    if (color.a < 0.5)
        col = albedo * 0.3 + _EngineColor * _EngineGlow;
    return col;
}

#endif
